# Builder stage: install deps with uv, create venv
FROM python:3.12-slim AS builder

WORKDIR /build

# Create venv explicitly (ensures pip is available)
RUN python -m venv /build/.venv

# Copy lock files only (cache-friendly)
COPY pyproject.toml uv.lock ./
COPY app/ ./app/

# Install uv into venv and sync dependencies
RUN /build/.venv/bin/pip install -U pip uv
RUN /build/.venv/bin/uv sync --frozen --no-dev

# Install local package to ensure CLI entry point is created
RUN /build/.venv/bin/pip install -e .

# Final stage: runtime only, no build tools
FROM python:3.12-slim

WORKDIR /app

# Copy pre-built venv from builder (no pip/uv needed)
COPY --from=builder /build/.venv /app/.venv

# Copy app code
COPY app/ ./app/
COPY pyproject.toml config.yaml ./

# Activate venv by default
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

# Reinstall package to fix entry point shebangs after venv copy
RUN /app/.venv/bin/python -m pip install --force-reinstall --no-deps -e .

# Default: serve API on :8080
# Override: docker run my-image ohmydb mcp (for MCP)
#           docker run my-image ohmydb sync (for sync)
CMD ["ohmydb", "serve"]
