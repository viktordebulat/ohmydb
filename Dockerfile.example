# syntax=docker/dockerfile:1

# Builder: resolve + install deps into a self-contained venv with uv.
FROM python:3.12-slim AS builder

# uv binary from its official distroless image — no pip bootstrap needed.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /src

# Deps first (cache layer independent of app code).
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

# Then the project itself, installed non-editable so the venv is fully
# self-contained (no .pth pointing back at this build dir). --reinstall-package
# rebuilds our wheel even when the version is unchanged (the cached uv wheel is
# keyed on version, so it would otherwise go stale across code edits).
COPY app/ ./app/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable --reinstall-package ohmydb

# Final: runtime only. No uv, no pip, no build tools.
FROM python:3.12-slim

# Strip the base image's system pip/setuptools — the app runs from a
# self-contained venv and nothing should install packages at runtime.
RUN python -m pip uninstall -y pip setuptools 2>/dev/null || true

# Drop root. Own /app so the catalog sqlite (storage url
# sqlite:///ohmydb.sqlite, relative to WORKDIR) is writable — mount a volume
# here to persist it across restarts.
RUN useradd --uid 10001 app && mkdir -p /app && chown app:app /app
WORKDIR /app

# The venv carries the installed app package — nothing else is baked in.
COPY --from=builder --chown=app:app /opt/venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    OHMYDB_CONFIG=/etc/ohmydb/config.yaml

USER app
EXPOSE 8080

# No config baked into the image. Mount it (k8s configmap / docker -v) at
# OHMYDB_CONFIG and inject CLICKHOUSE_USER / CLICKHOUSE_PASSWORD via secrets.
#   docker run -v ./config.yaml:/etc/ohmydb/config.yaml \
#     -e CLICKHOUSE_PASSWORD=... IMAGE
#
# API + MCP on one host: MCP at /mcp, API at :8080. Bind 0.0.0.0 so the port
# is reachable from outside the container. Override CMD for one-shot jobs,
# e.g. `docker run IMAGE ohmydb sync`.
CMD ["ohmydb", "serve", "--host", "0.0.0.0"]
